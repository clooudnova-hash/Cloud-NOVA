{
  "name": "cloudnova",
  "version": "1.0.0",
  "description": "CLOUDNOVA Cloud Mining Platform",
  "main": "Backend/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node scripts/ensure-build.js && node Backend/index.js",
    "dev": "node scripts/ensure-build.js && node Backend/index.js",
    "build": "npm install --prefix Backend && npm install --prefix FrontEnd && cd FrontEnd && npm run build",
    "android:debug": "npm --prefix FrontEnd run android:debug"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5"
  }
}
