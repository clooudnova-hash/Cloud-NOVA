# CloudNova Backend - Environment Variables
# Copy this file to .env and fill in production values

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Secret (REQUIRED in production - use strong 32+ character string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Data Persistence
# For Railway deployment, use the volume mount path
# CLOUDNOVA_DATA_FILE is automatically set by Railway via RAILWAY_VOLUME_MOUNT_PATH
# For local development, leave empty to use ./Backend/data/cloudnova-state.json
CLOUDNOVA_DATA_FILE=

# API Configuration
CORS_ORIGIN=*

# Optional: Override Railway volume mount path if needed
# RAILWAY_VOLUME_MOUNT_PATH=/tmp/railway

# Database backup (optional)
ENABLE_BACKUP=true
BACKUP_INTERVAL_HOURS=1
